<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Select Plant | Vehicle Information System</title>
<script>window.VIS_PLANT=null;window.VIS_PLANT_LABEL="";</script>
<script src="plant-context.js"></script>
<!-- Shared responsive UI theme: include this file in every page. -->
<style>
  :root {
    --ui-brand-950: #082b4a;
    --ui-brand-900: #0b365c;
    --ui-brand-800: #104b79;
    --ui-brand-700: #17679d;
    --ui-brand-600: #2182bd;
    --ui-accent: #18a36f;
    --ui-accent-soft: #eaf8f2;
    --ui-ink: #17263a;
    --ui-muted: #64748b;
    --ui-line: #dce6ef;
    --ui-surface: rgba(255, 255, 255, 0.96);
    --ui-surface-soft: #f5f8fb;
    --ui-page: #edf3f8;
    --ui-danger: #b42318;
    --ui-warning: #8a5a00;
    --ui-shadow-sm: 0 6px 18px rgba(18, 55, 88, 0.08);
    --ui-shadow-md: 0 14px 38px rgba(18, 55, 88, 0.13);
    --ui-shadow-lg: 0 24px 64px rgba(18, 55, 88, 0.18);
    --ui-radius-sm: 12px;
    --ui-radius-md: 18px;
    --ui-radius-lg: 26px;
    --ui-content-width: 1280px;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    padding: 0 0 50px !important;
    color: var(--ui-ink) !important;
    background-color: var(--ui-page) !important;
    background-image:
      radial-gradient(circle at 8% 0%, rgba(33, 130, 189, 0.13), transparent 30%),
      radial-gradient(circle at 94% 8%, rgba(24, 163, 111, 0.10), transparent 26%),
      linear-gradient(180deg, rgba(248, 251, 253, 0.94) 0%, rgba(237, 243, 248, 0.96) 100%),
      var(--page-background-image, none) !important;
    background-size: auto, auto, auto, cover !important;
    background-position: center, center, center, center !important;
    background-repeat: no-repeat !important;
    background-attachment: fixed !important;
    font-family:
      Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, Arial, Helvetica, sans-serif !important;
    line-height: 1.5;
    text-rendering: optimizeLegibility;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(11, 54, 92, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 54, 92, 0.025) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black, transparent 75%);
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible {
    outline: 3px solid rgba(33, 130, 189, 0.30) !important;
    outline-offset: 3px;
  }

  img {
    max-width: 100%;
  }

  .app-topbar {
    position: sticky;
    top: 0;
    z-index: 950;
    width: 100%;
    border-bottom: 1px solid rgba(220, 230, 239, 0.82);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    transition: box-shadow 0.2s ease, background 0.2s ease;
  }

  .app-topbar.scrolled {
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--ui-shadow-sm);
  }

  .app-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: min(calc(100% - 32px), var(--ui-content-width));
    min-height: 68px;
    margin: 0 auto;
  }

  .app-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--ui-brand-950);
    text-decoration: none;
  }

  .app-brand-mark {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 13px;
    color: white;
    background: linear-gradient(145deg, var(--ui-brand-800), var(--ui-brand-600));
    box-shadow: 0 8px 20px rgba(16, 75, 121, 0.24);
  }

  .app-brand-mark svg {
    width: 23px;
    height: 23px;
  }

  .app-brand-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    line-height: 1.15;
  }

  .app-brand-title {
    overflow: hidden;
    font-size: 15px;
    font-weight: 850;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-brand-subtitle {
    margin-top: 4px;
    color: var(--ui-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .app-topbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .app-selected-plant {
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--ui-brand-900);
    background: var(--ui-accent-soft);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }

  .app-home-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 15px;
    border: 1px solid var(--ui-line);
    border-radius: 999px;
    color: var(--ui-brand-900);
    background: white;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(18, 55, 88, 0.06);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .app-home-button:hover {
    border-color: rgba(33, 130, 189, 0.46);
    transform: translateY(-1px);
    box-shadow: var(--ui-shadow-sm);
  }

  .app-progress-shell {
    width: min(100%, var(--ui-content-width));
    margin: 0 auto 22px;
    padding: 0 2px;
  }

  .app-progress {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(220, 230, 239, 0.94);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--ui-shadow-sm);
    backdrop-filter: blur(10px);
  }

  .app-progress-step {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 0;
    min-height: 52px;
    padding: 8px 12px;
    color: #8290a3;
    background: transparent;
    font-size: 12px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }

  .app-progress-step + .app-progress-step {
    border-left: 1px solid var(--ui-line);
  }

  .app-progress-number {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 27px;
    height: 27px;
    border: 1px solid #cfd9e3;
    border-radius: 50%;
    background: #f7f9fb;
    font-size: 11px;
  }

  .app-progress-step.completed {
    color: var(--ui-brand-800);
    background: rgba(234, 248, 242, 0.52);
  }

  .app-progress-step.completed .app-progress-number {
    border-color: rgba(24, 163, 111, 0.32);
    color: #0d7e54;
    background: var(--ui-accent-soft);
  }

  .app-progress-step.active {
    color: white;
    background: linear-gradient(135deg, var(--ui-brand-900), var(--ui-brand-700));
  }

  .app-progress-step.active .app-progress-number {
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--ui-brand-900);
    background: white;
  }

  .page-container {
    width: min(calc(100% - 32px), var(--ui-content-width)) !important;
    max-width: var(--ui-content-width) !important;
    margin-right: auto !important;
    margin-left: auto !important;
  }

  .header {
    margin: 18px auto 26px !important;
    padding: clamp(28px, 5vw, 54px) clamp(22px, 5vw, 60px) !important;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: var(--ui-radius-lg);
    background:
      radial-gradient(circle at 88% 8%, rgba(255, 255, 255, 0.22), transparent 28%),
      linear-gradient(135deg, var(--ui-brand-950), var(--ui-brand-700)) !important;
    box-shadow: var(--ui-shadow-lg);
  }

  .header h1 {
    color: white !important;
    font-size: clamp(30px, 5vw, 48px) !important;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .header p {
    max-width: 680px;
    margin-right: auto !important;
    margin-left: auto !important;
    color: rgba(235, 246, 255, 0.86) !important;
    font-size: clamp(15px, 2vw, 18px) !important;
  }

  .company-logo-container {
    margin-bottom: 20px !important;
  }

  .company-logo {
    max-width: min(240px, 65vw) !important;
    max-height: 88px !important;
    padding: 8px 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.92);
    filter: none !important;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.15);
  }

  .page-heading {
    position: relative;
    overflow: hidden;
    margin-bottom: 22px !important;
    padding: clamp(24px, 4vw, 38px) !important;
    border: 1px solid rgba(255, 255, 255, 0.52) !important;
    border-radius: var(--ui-radius-lg) !important;
    background:
      radial-gradient(circle at 90% 8%, rgba(255, 255, 255, 0.20), transparent 28%),
      linear-gradient(135deg, var(--ui-brand-950), var(--ui-brand-700)) !important;
    box-shadow: var(--ui-shadow-md) !important;
  }

  .page-heading h1 {
    margin-bottom: 8px !important;
    font-size: clamp(27px, 4vw, 40px) !important;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .selection-path {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    color: rgba(231, 244, 255, 0.88) !important;
    font-size: clamp(14px, 2vw, 17px) !important;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px !important;
    margin: 18px 0 16px !important;
    padding: 0 18px !important;
    border: 1px solid var(--ui-line) !important;
    border-radius: 999px !important;
    color: var(--ui-brand-900) !important;
    background: rgba(255, 255, 255, 0.96) !important;
    box-shadow: var(--ui-shadow-sm);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease !important;
  }

  .back-button:hover {
    border-color: rgba(33, 130, 189, 0.55) !important;
    color: var(--ui-brand-900) !important;
    background: white !important;
    transform: translateY(-2px);
    box-shadow: var(--ui-shadow-md);
  }

  .selection-card,
  .selection-section,
  .comparison-section,
  .grade-section,
  .module-section,
  .underbody-card,
  .assembly-section {
    border: 1px solid rgba(220, 230, 239, 0.95) !important;
    border-radius: var(--ui-radius-lg) !important;
    background: var(--ui-surface) !important;
    box-shadow: var(--ui-shadow-md) !important;
  }

  .selection-card,
  .selection-section,
  .comparison-section,
  .grade-section,
  .module-section {
    padding: clamp(20px, 3.5vw, 36px) !important;
  }

  .section-heading,
  .section-title,
  .module-section h2 {
    color: var(--ui-brand-900) !important;
    font-size: clamp(23px, 3vw, 30px) !important;
    letter-spacing: -0.02em;
  }

  .section-description,
  .module-instruction,
  .flow-information {
    color: var(--ui-muted) !important;
  }

  .model-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)) !important;
    gap: clamp(16px, 2.5vw, 24px) !important;
  }

  .model-card,
  .grade-card,
  .variant-choice,
  .module-button {
    position: relative;
    overflow: hidden;
    border-color: var(--ui-line) !important;
    border-radius: var(--ui-radius-md) !important;
    background: white !important;
    box-shadow: 0 8px 22px rgba(18, 55, 88, 0.08) !important;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease !important;
  }

  .model-card::after,
  .grade-card::after,
  .variant-choice::after,
  .module-button::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 4px;
    background: linear-gradient(90deg, var(--ui-brand-700), var(--ui-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .model-card:hover,
  .grade-card:hover,
  .variant-choice:hover,
  .module-button:hover {
    border-color: rgba(33, 130, 189, 0.56) !important;
    color: inherit !important;
    background: white !important;
    transform: translateY(-5px) !important;
    box-shadow: 0 18px 38px rgba(18, 55, 88, 0.16) !important;
  }

  .model-card:hover::after,
  .grade-card:hover::after,
  .variant-choice:hover::after,
  .module-button:hover::after {
    transform: scaleX(1);
  }

  .model-image-frame,
  .grade-picture,
  .underbody-picture,
  .overview-image-container,
  .difference-picture,
  .comparison-image-box,
  .assembly-tagging-image {
    background:
      linear-gradient(145deg, #eef4f8, #ffffff) !important;
  }

  .model-image-frame {
    aspect-ratio: 16 / 9 !important;
    padding: clamp(14px, 2vw, 22px) !important;
  }

  .model-information {
    padding: 20px 22px 22px !important;
  }

  .model-name,
  .grade-name,
  .variant-choice-name,
  .part-name,
  .overview-information h3,
  .underbody-information h3 {
    color: var(--ui-brand-900) !important;
  }

  .arrow {
    background: linear-gradient(145deg, var(--ui-brand-800), var(--ui-brand-600)) !important;
    box-shadow: 0 6px 15px rgba(16, 75, 121, 0.25);
  }

  .variant-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)) !important;
  }

  .variant-choice {
    min-height: 148px !important;
    border-top-width: 6px !important;
  }

  .variant-colour-code,
  .comparison-card,
  .overview-card,
  .assembly-tagging-panel,
  .assembly-tagging-card,
  .table-wrapper,
  .comparison-wrapper {
    border-color: var(--ui-line) !important;
    border-radius: var(--ui-radius-md) !important;
    background: white !important;
    box-shadow: var(--ui-shadow-sm);
  }

  .comparison-header,
  .assembly-title,
  .underbody-header,
  .assembly-tagging-card-title,
  .comparison-table th {
    background: linear-gradient(135deg, var(--ui-brand-900), var(--ui-brand-700)) !important;
  }

  .select-variant-button {
    min-height: 46px !important;
    border-radius: 999px !important;
  }

  .difference-item {
    grid-template-columns: minmax(180px, 240px) 1fr !important;
  }

  .grade-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr)) !important;
  }

  .module-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)) !important;
    gap: 16px !important;
  }

  .module-button {
    min-height: 112px !important;
    padding: 20px !important;
    color: var(--ui-brand-900) !important;
    font-size: clamp(16px, 2vw, 18px) !important;
  }

  .underbody-card,
  .assembly-section {
    overflow: hidden;
  }

  .underbody-picture,
  .overview-image-container {
    min-height: clamp(260px, 42vw, 520px) !important;
  }

  .overview-image,
  .underbody-picture img,
  .small-part-image,
  .comparison-image,
  .difference-picture img,
  .assembly-tagging-image img {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .overview-image:hover,
  .underbody-picture img:hover,
  .small-part-image:hover,
  .comparison-image:hover,
  .difference-picture img:hover,
  .assembly-tagging-image img:hover {
    transform: scale(1.015);
  }

  .parts-table,
  .comparison-table {
    border-collapse: separate !important;
    border-spacing: 0;
  }

  .parts-table th {
    position: sticky;
    top: 68px;
    z-index: 10;
    color: var(--ui-brand-900) !important;
    background: #eef4f8 !important;
  }

  .parts-table td,
  .parts-table th,
  .comparison-table td,
  .comparison-table th {
    border-color: #e5edf3 !important;
  }

  .parts-table tbody tr:nth-child(even) td {
    background: #fbfdfe;
  }

  .parts-table tbody tr:hover td {
    background: #eef7fc !important;
  }

  .comparison-table th:first-child,
  .comparison-table td:first-child {
    position: sticky;
    left: 0;
  }

  .comparison-table th:first-child {
    z-index: 4;
  }

  .comparison-table td:first-child {
    z-index: 2;
    background: #f5f8fb !important;
  }

  .loading-message,
  .empty-message,
  .error-message {
    border-radius: var(--ui-radius-md) !important;
    box-shadow: var(--ui-shadow-sm);
  }

  .loading-message {
    color: var(--ui-brand-900) !important;
    background: rgba(255, 255, 255, 0.92) !important;
  }

  .empty-message {
    color: var(--ui-warning) !important;
    background: #fffaf0 !important;
  }

  .error-message {
    color: var(--ui-danger) !important;
    background: #fff3f2 !important;
  }

  .spinner {
    border-color: #d8e8f2 !important;
    border-top-color: var(--ui-brand-700) !important;
  }

  .image-modal {
    z-index: 2000 !important;
    background: rgba(4, 18, 31, 0.94) !important;
    backdrop-filter: blur(8px);
  }

  .modal-close,
  .modal-control-button {
    min-width: 46px;
    min-height: 46px;
    border-color: rgba(255, 255, 255, 0.36) !important;
    background: rgba(255, 255, 255, 0.13) !important;
    backdrop-filter: blur(8px);
  }

  .global-back-to-top-button {
    min-width: 50px !important;
    min-height: 50px !important;
    border: 0 !important;
    background: linear-gradient(145deg, var(--ui-brand-800), var(--ui-brand-600)) !important;
    box-shadow: 0 14px 34px rgba(16, 75, 121, 0.30) !important;
  }

  .app-results-tools {
    position: sticky;
    top: 78px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 20px;
    padding: 12px;
    border: 1px solid rgba(220, 230, 239, 0.94);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--ui-shadow-sm);
    backdrop-filter: blur(12px);
  }

  .app-search-wrap {
    position: relative;
    flex: 1 1 auto;
  }

  .app-search-icon {
    position: absolute;
    top: 50%;
    left: 15px;
    width: 18px;
    height: 18px;
    color: #7890a4;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .app-results-search {
    width: 100%;
    min-height: 46px;
    padding: 0 44px 0 44px;
    border: 1px solid #cfdce7;
    border-radius: 13px;
    color: var(--ui-ink);
    background: #f8fbfd;
    font-size: 14px;
    font-weight: 650;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .app-results-search:focus {
    border-color: var(--ui-brand-600);
    background: white;
    box-shadow: 0 0 0 4px rgba(33, 130, 189, 0.11);
  }

  .app-search-clear {
    position: absolute;
    top: 50%;
    right: 8px;
    display: none;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 9px;
    color: var(--ui-muted);
    background: transparent;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .app-search-clear.visible {
    display: inline-grid;
    place-items: center;
  }

  .app-search-count {
    flex: 0 0 auto;
    min-width: 92px;
    color: var(--ui-muted);
    font-size: 12px;
    font-weight: 800;
    text-align: right;
  }

  .app-no-search-results {
    display: none;
    margin-bottom: 20px;
    padding: 22px;
    border: 1px dashed #c9d9e5;
    border-radius: 16px;
    color: var(--ui-muted);
    background: rgba(255, 255, 255, 0.88);
    text-align: center;
  }

  .app-no-search-results.visible {
    display: block;
  }

  .app-enter {
    animation: appEnter 0.42s cubic-bezier(.2,.75,.25,1) both;
  }

  @keyframes appEnter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .app-progress-label {
      font-size: 11px;
    }

    .difference-item {
      grid-template-columns: 1fr !important;
    }

    .difference-picture {
      height: min(260px, 55vw) !important;
    }

    .assembly-tagging-grid {
      grid-template-columns: 1fr !important;
    }
  }

  @media (max-width: 700px) {
    body {
      padding: 0 0 34px !important;
    }

    .app-topbar-inner {
      width: calc(100% - 20px);
      min-height: 60px;
      flex-wrap: wrap;
      gap: 8px;
      padding: 10px 0;
    }

    .app-brand { width: 100%; }
    .app-topbar-actions { width: 100%; flex-wrap: wrap; }
    .app-selected-plant { margin-right: auto; }
    .app-home-button[data-change-plant] { width: auto; padding: 0 12px; white-space: nowrap; }

    .app-brand-mark {
      width: 36px;
      height: 36px;
