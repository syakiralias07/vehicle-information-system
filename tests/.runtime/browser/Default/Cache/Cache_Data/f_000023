<script>
  (function () {
    'use strict';

    const STEPS = [
      { key: 'home', label: 'Model' },
      { key: 'variants', label: 'Variant' },
      { key: 'grades', label: 'Grade / Market' },
      { key: 'modules', label: 'Module' },
      { key: 'results', label: 'Parts' }
    ];

    function getBaseUrl() {
      if (typeof WEB_APP_URL !== 'undefined' && WEB_APP_URL) {
        return WEB_APP_URL;
      }

      return new URL('index.php',window.location.href).toString();
    }

    function getCurrentPage() {
      const page = new URLSearchParams(window.location.search).get('page');
      if (page) {
        return String(page).toLowerCase();
      }

      if (document.querySelector('.assembly-section') || /assembly overview/i.test(document.title + ' ' + document.body.textContent.slice(0, 400))) {
        return 'results';
      }
      if (document.querySelector('.underbody-card') || /full underbody assembly/i.test(document.body.textContent.slice(0, 500))) {
        return 'modules';
      }
      if (document.getElementById('pageTitle') || /select grade|select market/i.test(document.body.textContent.slice(0, 500))) {
        return 'grades';
      }
      if (/select variant/i.test(document.body.textContent.slice(0, 500))) {
        return 'variants';
      }
      return 'home';
    }

    function getCurrentStepIndex() {
      const page = getCurrentPage();
      const index = STEPS.findIndex(function (step) {
        return step.key === page;
      });
      return index < 0 ? 0 : index;
    }

    function buildUrl(page, params) {
      const url = new URL(getBaseUrl(), window.location.href);
      url.search = '';
      if(window.VIS_PLANT) url.searchParams.set('plant',window.VIS_PLANT);

      if (page !== 'home') {
        url.searchParams.set('page', page);
      }

      Object.keys(params || {}).forEach(function (key) {
        const value = params[key];
        if (value) {
          url.searchParams.set(key, value);
        }
      });

      return url.toString();
    }

    function createTopbar() {
      if (document.querySelector('.app-topbar')) {
        return;
      }

      const topbar = document.createElement('nav');
      topbar.className = 'app-topbar';
      topbar.setAttribute('aria-label', 'Main navigation');

      const homeUrl = buildUrl('home', {});
      topbar.innerHTML =
        '<div class="app-topbar-inner">' +
          '<a class="app-brand" href="' + homeUrl + '" target="_top" aria-label="Vehicle Information System home">' +
            '<span class="app-brand-mark" aria-hidden="true">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
                '<path d="M3 14.5 5.1 9a2 2 0 0 1 1.87-1.28h10.06A2 2 0 0 1 18.9 9l2.1 5.5" />' +
                '<path d="M5 14.5h14a2 2 0 0 1 2 2V19h-2.2a2.2 2.2 0 0 1-4.2 0H9.4a2.2 2.2 0 0 1-4.2 0H3v-2.5a2 2 0 0 1 2-2Z" />' +
                '<path d="M7 14.5 8.2 11h7.6l1.2 3.5" />' +
              '</svg>' +
            '</span>' +
            '<span class="app-brand-copy">' +
              '<span class="app-brand-title">Vehicle Information System</span>' +
              '<span class="app-brand-subtitle">Assembly Database</span>' +
            '</span>' +
          '</a>' +
          '<div class="app-topbar-actions">' +
            '<span class="app-selected-plant">' + window.VIS_PLANT_LABEL + '</span>' +
            '<a class="app-home-button" href="index.php" data-change-plant>Change Plant</a>' +
            '<a class="app-home-button" href="' + homeUrl + '" target="_top">' +
              '<span aria-hidden="true">⌂</span>' +
              '<span class="app-home-text">Home</span>' +
             '</a>' +
             (getCurrentPage() === 'home' ?
               '<a class="app-home-button" href="admin.php" target="_top" aria-label="Admin Login">' +
                 '<span aria-hidden="true">&#128274;</span>' +
                 '<span class="app-admin-text">Admin Login</span>' +
               '</a>' : '') +
           '</div>' +
         '</div>';

      document.body.insertBefore(topbar, document.body.firstChild);

      window.addEventListener('scroll', function () {
        topbar.classList.toggle('scrolled', window.scrollY > 8);
      }, { passive: true });
    }

    function getStepUrl(stepIndex, values) {
      switch (stepIndex) {
        case 0:
          return buildUrl('home', {});
        case 1:
          return values.model
            ? buildUrl('variants', { model: values.model })
            : '';
        case 2:
          return values.model && values.variant
            ? buildUrl('grades', {
                model: values.model,
                variant: values.variant
              })
            : '';
        case 3:
          return values.model && values.variant && values.grade
            ? buildUrl('modules', {
                model: values.model,
                variant: values.variant,
                grade: values.grade
              })
            : '';
        default:
          return '';
      }
    }

    function createProgress() {
      const container = document.querySelector('.page-container');
      if (!container || container.querySelector('.app-progress-shell')) {
        return;
      }

      const params = new URLSearchParams(window.location.search);
      const values = {
        model:
          (typeof SELECTED_MODEL !== 'undefined' && SELECTED_MODEL) ||
          params.get('model') ||
          '',
        variant:
          (typeof SELECTED_VARIANT !== 'undefined' && SELECTED_VARIANT) ||
          params.get('variant') ||
          '',
        grade:
          (typeof SELECTED_GRADE !== 'undefined' && SELECTED_GRADE) ||
          params.get('grade') ||
          '',
        module:
          (typeof SELECTED_MODULE !== 'undefined' && SELECTED_MODULE) ||
          params.get('module') ||
          ''
      };

      const activeIndex = getCurrentStepIndex();
      const shell = document.createElement('div');
      shell.className = 'app-progress-shell';
      shell.setAttribute('aria-label', 'Selection progress');

      const progress = document.createElement('div');
      progress.className = 'app-progress';

      STEPS.forEach(function (step, index) {
        const url = index < activeIndex ? getStepUrl(index, values) : '';
        const element = url
          ? document.createElement('a')
          : document.createElement('div');

        element.className = 'app-progress-step';
        if (index < activeIndex) {
          element.classList.add('completed');
        } else if (index === activeIndex) {
          element.classList.add('active');
          element.setAttribute('aria-current', 'step');
        }

        if (url) {
          element.href = url;
          element.target = '_top';
          element.title = 'Return to ' + step.label;
        }

        element.innerHTML =
          '<span class="app-progress-number">' +
            (index < activeIndex ? '✓' : String(index + 1)) +
          '</span>' +
          '<span class="app-progress-label">' + step.label + '</span>';

        progress.appendChild(element);
      });

      shell.appendChild(progress);

      const firstMainElement = container.querySelector('.back-button, .header, .page-heading');
      if (firstMainElement) {
        container.insertBefore(shell, firstMainElement);
      } else {
        container.insertBefore(shell, container.firstChild);
      }

      const activeStep = progress.querySelector('.app-progress-step.active');
      if (activeStep && window.innerWidth <= 700) {
        window.setTimeout(function () {
          activeStep.scrollIntoView({ inline: 'center', block: 'nearest' });
        }, 60);
      }
    }

    function improveDynamicContent(root) {
      const scope = root || document;

      scope.querySelectorAll('img:not([loading])').forEach(function (image) {
        if (!image.classList.contains('company-logo') && image.id !== 'modalImage') {
          image.loading = 'lazy';
          image.decoding = 'async';
        }
      });

      scope.querySelectorAll('.loading-message, .error-message, .empty-message').forEach(function (message) {
        message.setAttribute('role', 'status');
        message.setAttribute('aria-live', 'polite');
      });

      scope.querySelectorAll('.model-card, .grade-card, .variant-choice, .module-button, .comparison-card, .assembly-section, .underbody-card').forEach(function (card, index) {
        if (!card.classList.contains('app-enter')) {
          card.classList.add('app-enter');
          card.style.animationDelay = Math.min(index * 35, 210) + 'ms';
        }
      });
    }

    function installResultsSearch() {
      if (getCurrentPage() !== 'results') {
        return;
      }

      const content = document.getElementById('content');
      if (!content || content.querySelector('.app-results-tools')) {
        return;
      }

      const rows = Array.prototype.slice.call(
        content.querySelectorAll('.parts-table tbody tr')
      );

      if (!rows.length) {
        return;
      }

      const tools = document.createElement('div');
      tools.className = 'app-results-tools';
      tools.innerHTML =
        '<div class="app-search-wrap">' +
          '<svg class="app-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
            '<circle cx="11" cy="11" r="7"></circle>' +
            '<path d="m20 20-3.5-3.5"></path>' +
          '</svg>' +
          '<input class="app-results-search" type="search" autocomplete="off" spellcheck="false" ' +
            'placeholder="Search part name or part number…" aria-label="Search parts">' +
          '<button class="app-search-clear" type="button" aria-label="Clear search">×</button>' +
        '</div>' +
        '<div class="app-search-count" aria-live="polite"></div>';

      const noResults = document.createElement('div');
      noResults.className = 'app-no-search-results';
      noResults.textContent = 'No parts match your search. Try another part name or number.';

      content.insertBefore(tools, content.firstChild);
      content.insertBefore(noResults, tools.nextSibling);

      const input = tools.querySelector('.app-results-search');
      const clearButton = tools.querySelector('.app-search-clear');
      const count = tools.querySelector('.app-search-count');

      function normalise(value) {
        return String(value || '').trim().toLowerCase();
      }

      function update() {
        const query = normalise(input.value);
        let visible = 0;

        rows.forEach(function (row) {
          const matches = !query || normalise(row.textContent).indexOf(query) !== -1;
          row.hidden = !matches;
          if (matches) {
            visible += 1;
          }
        });

        clearButton.classList.toggle('visible', Boolean(query));
        count.textContent = visible + ' of ' + rows.length + ' parts';
        noResults.classList.toggle('visible', visible === 0);
      }

      input.addEventListener('input', update);
      input.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && input.value) {
          input.value = '';
          update();
        }
      });
      clearButton.addEventListener('click', function () {
        input.value = '';
        update();
        input.focus();
      });

      update();
    }

    function observeDynamicContent() {
      const observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
          mutation.addedNodes.forEach(function (node) {
            if (node.nodeType === 1) {
              improveDynamicContent(node);
            }
          });
        });

        installResultsSearch();
      });

      observer.observe(document.body, {
        childList: true,
        subtree: true
      });
    }

    function initialise() {
      if (!window.VIS_PLANT) return;
      createTopbar();
      createProgress();
      improveDynamicContent(document);
      installResultsSearch();
      observeDynamicContent();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialise, { once: true });
    } else {
      initialise();
    }
  })();
</script>
