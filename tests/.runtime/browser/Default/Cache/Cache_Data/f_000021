    function renderOverview(
      section,
      assembly,
      contentType
    ) {
      const overviewArea =
        document.createElement('div');

      overviewArea.className =
        'overview-area';

      if (
        !assembly.overview ||
        assembly.overview.length === 0
      ) {
        overviewArea.innerHTML =
          '<div class="empty-message">' +
            'No overview record was found.' +
          '</div>';

        section.appendChild(
          overviewArea
        );

        return;
      }

      const isOplSection =
        contentType === 'opl';

      assembly.overview.forEach(function (
        overview,
        overviewIndex
      ) {
        const overviewCard =
          document.createElement('article');

        overviewCard.className =
          isOplSection || overviewIndex > 0
            ? 'overview-card actual-part-card'
            : 'overview-card';

        const imageContainer =
          document.createElement('div');

        imageContainer.className =
          'overview-image-container';

        appendImageOrPlaceholder(
          imageContainer,
          overview.imageUrl,
          overview.pictureName,
          'overview-image'
        );

        const information =
          document.createElement('div');

        information.className =
          'overview-information';

        const name =
          document.createElement('h3');

        name.textContent =
          overview.pictureName ||
          assembly.assemblyName;

        information.appendChild(name);

        if (overview.description) {
          const description =
            document.createElement('p');

          description.textContent =
            overview.description;

          information.appendChild(
            description
          );
        }

        const label =
          document.createElement('span');

        label.className =
          'overview-label';

        label.textContent =
          isOplSection
            ? 'OPL'
            : (
                overviewIndex === 0
                  ? 'OVERVIEW'
                  : 'ACTUAL PART'
              );

        information.appendChild(label);

        overviewCard.appendChild(
          imageContainer
        );

        if (
          !isOplSection &&
          shouldShowDiagramLegend(
            overview
          )
        ) {
          try {
            overviewCard.appendChild(
              buildDiagramLegend()
            );
          } catch (legendError) {
            console.error(
              'Unable to render diagram legend:',
              legendError
            );
          }
