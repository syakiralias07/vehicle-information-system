    let modalZoom = 1;
    let modalPanX = 0;
    let modalPanY = 0;
    let modalDragging = false;
    let modalDragStartX = 0;
    let modalDragStartY = 0;
    let modalPanStartX = 0;
    let modalPanStartY = 0;


    function applyModalTransform() {
      const modalImage =
        document.getElementById(
          'modalImage'
        );

      const panLayer =
        document.getElementById(
          'modalPanLayer'
        );

      const zoomLevel =
        document.getElementById(
          'modalZoomLevel'
        );

      if (
        !modalImage ||
        !panLayer ||
        !zoomLevel
      ) {
        return;
      }

      modalImage.style.transform =
        'scale(' + modalZoom + ')';

      panLayer.style.transform =
        'translate3d(' +
        modalPanX + 'px, ' +
        modalPanY + 'px, 0)';

      zoomLevel.textContent =
        Math.round(
          modalZoom * 100
        ) + '%';
    }


    function zoomModalImage(change) {
      const nextZoom =
        Math.min(
          5,
          Math.max(
            0.5,
            modalZoom + change
          )
        );

      modalZoom = nextZoom;

      if (modalZoom <= 1) {
        modalPanX = 0;
        modalPanY = 0;
      }

      applyModalTransform();
    }


    function resetModalZoom() {
      modalZoom = 1;
      modalPanX = 0;
      modalPanY = 0;
      applyModalTransform();
    }


    function setupModalZoomControls() {
      const viewport =
        document.getElementById(
          'modalViewport'
        );

      if (!viewport) {
        return;
      }

      viewport.addEventListener(
        'wheel',
        function (event) {
          event.preventDefault();

          zoomModalImage(
            event.deltaY < 0
              ? 0.25
              : -0.25
          );
        },
        { passive: false }
      );

      viewport.addEventListener(
        'pointerdown',
        function (event) {
          if (modalZoom <= 1) {
            return;
          }

          modalDragging = true;

          modalDragStartX =
            event.clientX;

          modalDragStartY =
            event.clientY;

          modalPanStartX =
            modalPanX;

          modalPanStartY =
            modalPanY;

          viewport.classList.add(
            'dragging'
          );

          viewport.setPointerCapture(
            event.pointerId
          );
        }
      );

      viewport.addEventListener(
        'pointermove',
        function (event) {
          if (!modalDragging) {
            return;
          }

          modalPanX =
            modalPanStartX +
            (
              event.clientX -
              modalDragStartX
            );

          modalPanY =
            modalPanStartY +
            (
              event.clientY -
              modalDragStartY
            );

          applyModalTransform();
        }
      );

      function stopDragging(event) {
        if (!modalDragging) {
          return;
        }

        modalDragging = false;

        viewport.classList.remove(
          'dragging'
        );

        if (
          event &&
          event.pointerId !== undefined &&
          viewport.hasPointerCapture(
            event.pointerId
          )
        ) {
          viewport.releasePointerCapture(
            event.pointerId
          );
        }
      }

      viewport.addEventListener(
        'pointerup',
        stopDragging
      );

      viewport.addEventListener(
        'pointercancel',
        stopDragging
      );

      viewport.addEventListener(
        'dblclick',
        function () {
          if (modalZoom === 1) {
            modalZoom = 2;
            applyModalTransform();
          } else {
            resetModalZoom();
          }
        }
      );
    }


    function openImageModal(
      imageUrl,
      altText
    ) {
      const modal =
        document.getElementById(
          'imageModal'
        );

      const modalImage =
        document.getElementById(
          'modalImage'
        );

      modalImage.src =
        imageUrl;

      modalImage.alt =
        altText || 'Enlarged picture';

      resetModalZoom();

      modal.classList.add(
        'open'
      );

      document.body.style.overflow =
        'hidden';
    }


    function closeImageModal(event) {
      if (
        event &&
        event.target &&
        event.target.id === 'modalImage'
      ) {
        return;
      }

      const modal =
        document.getElementById(
          'imageModal'
        );

      modal.classList.remove(
        'open'
      );

      document.getElementById(
        'modalImage'
      ).src = '';

      resetModalZoom();

      document.body.style.overflow =
        '';
    }


    document.addEventListener(
      'keydown',
      function (event) {
        const modal =
          document.getElementById(
            'imageModal'
          );

        const modalIsOpen =
          modal &&
          modal.classList.contains(
            'open'
          );

        if (event.key === 'Escape') {
          closeImageModal();
          return;
        }

        if (!modalIsOpen) {
          return;
        }

        if (
          event.key === '+' ||
          event.key === '='
        ) {
          event.preventDefault();
          zoomModalImage(0.25);
        }

        if (event.key === '-') {
          event.preventDefault();
          zoomModalImage(-0.25);
        }

        if (
          event.key === '0' ||
          event.key.toLowerCase() === 'r'
        ) {
          event.preventDefault();
          resetModalZoom();
        }
      }
    );


    function showError(messageText) {
      const results =
        document.getElementById(
          'results'
        );

      results.innerHTML = '';

      const message =
        document.createElement('div');

      message.className =
        'error-message';

      message.textContent =
        messageText;

      results.appendChild(
        message
