<!DOCTYPE html>
<html>
<head>
  <base target="_top">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 20px 16px 50px;
      font-family: Arial, Helvetica, sans-serif;
      color: #172033;
      background: #f2f6fb;
    }

    .page-container {
      width: 100%;
      max-width: 1260px;
      margin: 0 auto;
    }

    .back-button {
      min-height: 46px;
      margin-bottom: 24px;
      padding: 0 20px;
      border: 1px solid #194776;
      border-radius: 10px;
      color: #194776;
      background: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .back-button:hover {
      color: white;
      background: #194776;
    }

    .page-heading {
      margin-bottom: 24px;
      padding: 28px;
      border-radius: 18px;
      color: white;
      background:
        linear-gradient(
          135deg,
          #153f72,
          #28679e
        );
      box-shadow:
        0 12px 35px
        rgba(24, 66, 108, 0.18);
    }

    .page-heading h1 {
      margin: 0 0 10px;
      font-size: 34px;
    }

    .selection-path {
      margin: 0;
      color: #dcecff;
      font-size: 18px;
    }

    .result-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }

    .summary-chip {
      padding: 8px 12px;
      border: 1px solid #cddfed;
      border-radius: 999px;
      color: #194776;
      background: white;
      font-size: 13px;
      font-weight: 700;
    }

    .assembly-section {
      overflow: hidden;
      margin-bottom: 32px;
      border: 1px solid #dce5ef;
      border-radius: 18px;
      background: white;
      box-shadow:
        0 10px 30px
        rgba(31, 68, 112, 0.10);
    }

    .assembly-title {
      margin: 0;
      padding: 20px 25px;
      color: white;
      background: #194776;
      font-size: 24px;
    }

    .overview-area {
      padding: 24px;
      background: #eef3f8;
    }

    .overview-card {
      overflow: hidden;
      border: 1px solid #dce5ef;
      border-radius: 14px;
      background: white;
    }

    .overview-card + .overview-card {
      margin-top: 26px;
    }

    .overview-image-container {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 360px;
      padding: 18px;
      background: #f5f7fa;
    }

    .overview-image {
      display: block;
      width: 100%;
      max-width: 1200px;
      max-height: 900px;
      object-fit: contain;
      border-radius: 8px;
      cursor: zoom-in;
    }

    .actual-part-card {
      border: 2px solid #efb768;
    }

    .actual-part-card .overview-image-container {
      min-height: 480px;
      padding: 26px;
      background: #fffaf2;
    }

    .actual-part-card .overview-image {
      max-height: 980px;
    }

    .actual-part-card .overview-information {
      border-top: 1px solid #f2d3a8;
      background: #fffaf2;
    }

    .actual-part-card .overview-information h3 {
      color: #8a4b08;
    }

    .actual-part-card .overview-label {
      color: #8a4b08;
      background: #ffe9c7;
    }

    .overview-information {
      padding: 20px 24px;
    }

    .overview-information h3 {
      margin: 0 0 10px;
      color: #194776;
      font-size: 23px;
    }

    .overview-information p {
      margin: 0;
      color: #65758a;
      line-height: 1.6;
    }

    .overview-label {
      display: inline-block;
      margin-top: 12px;
      padding: 6px 11px;
      border-radius: 999px;
      color: #245689;
      background: #eaf3fc;
      font-size: 12px;
      font-weight: 700;
    }

    .part-lists-area {
      padding: 24px;
    }

    .part-list-block + .part-list-block {
      margin-top: 30px;
    }

    .list-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin: 0 0 14px;
      padding: 13px 16px;
      border-left: 5px solid #194776;
      border-radius: 9px;
      color: #194776;
      background: #edf4fb;
    }

    .list-heading h3 {
      margin: 0;
      font-size: 21px;
    }

    .list-count {
      color: #61758b;
      font-size: 13px;
      font-weight: 700;
    }

    .table-wrapper {
      overflow-x: auto;
      border: 1px solid #dde5ee;
      border-radius: 12px;
    }

    .parts-table {
      width: 100%;
      min-width: 720px;
      border-collapse: collapse;
      background: white;
    }

    .parts-table th {
      padding: 14px;
      color: #32445c;
      background: #f4f7fa;
      text-align: left;
      font-size: 14px;
    }

    .parts-table td {
      padding: 13px 14px;
      border-top: 1px solid #e2e8f0;
      vertical-align: middle;
    }

    .parts-table tbody tr:hover td {
      background: #f8fbff;
    }

    .picture-column {
      width: 145px;
    }

    .number-column {
      width: 220px;
    }

    .small-part-image {
      display: block;
      width: 115px;
      height: 82px;
      object-fit: contain;
      border: 1px solid #e1e6ec;
      border-radius: 8px;
      background: white;
      cursor: zoom-in;
    }

    .overview-image-container .no-image {
      width: 100%;
      min-height: 320px;
      height: auto;
      font-size: 15px;
    }

    .no-image {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 115px;
      height: 82px;
      border-radius: 8px;
      color: #8290a3;
      background: #edf1f5;
      font-size: 12px;
      text-align: center;
    }

    .part-name {
      color: #183f6f;
      font-weight: 700;
    }

    .part-number {
      color: #334a67;
      font-weight: 700;
    }

    .assembly-tagging {
      padding: 0 18px 22px;
      background: #edf4fb;
    }

    .assembly-tagging-panel {
      overflow: hidden;
      border: 1px solid #dce5ef;
      border-radius: 15px;
      background: white;
    }

    .assembly-tagging-heading {
      padding: 18px 20px;
      border-bottom: 1px solid #dce5ef;
      background: #f7faff;
    }

    .assembly-tagging-heading h3 {
      margin: 0 0 6px;
      color: #194776;
      font-size: 21px;
    }

    .assembly-tagging-heading p {
      margin: 0;
      color: #66778d;
      line-height: 1.5;
    }

    .tag-print-requirement {
      margin: 18px 18px 0;
      overflow: hidden;
      border: 1px solid #c9dcec;
      border-radius: 14px;
      background: #ffffff;
      box-shadow:
        0 6px 18px
        rgba(31, 68, 112, 0.07);
    }

    .tag-print-requirement-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      color: #ffffff;
      background:
        linear-gradient(
          135deg,
          #153f72,
          #28679e
        );
    }

    .tag-print-requirement-header h4 {
      margin: 0;
      font-size: 16px;
    }

    .tag-print-status {
      flex: 0 0 auto;
      padding: 5px 9px;
      border: 1px solid
        rgba(255,255,255,0.55);
      border-radius: 999px;
      color: #ffffff;
      background:
        rgba(255,255,255,0.14);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.35px;
      text-transform: uppercase;
    }

    .tag-print-intro {
      margin: 0;
      padding: 13px 16px 0;
      color: #607287;
      font-size: 13px;
      line-height: 1.5;
    }

    .tag-paper-detail-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 10px;
      padding: 13px 16px 14px;
    }

    .tag-paper-detail {
      min-width: 0;
      padding: 11px 12px;
      border: 1px solid #dce6ef;
      border-radius: 10px;
      background: #f9fbfd;
    }

    .tag-paper-detail-label {
      display: block;
      margin-bottom: 5px;
      color: #718096;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }

    .tag-paper-detail-value {
      display: flex;
      align-items: center;
      gap: 7px;
      min-height: 22px;
      color: #183f6f;
      font-size: 13px;
      font-weight: 800;
      line-height: 1.35;
      word-break: break-word;
    }

    .tag-paper-swatch {
      flex: 0 0 auto;
      width: 17px;
      height: 17px;
      border: 2px solid #475569;
      border-radius: 50%;
      background: var(
        --tag-paper-swatch,
        #ffffff
      );
      box-shadow:
        0 0 0 2px #ffffff;
    }

    .tag-print-instruction {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      margin: 0;
      padding: 11px 16px;
      border-top: 1px solid #dce6ef;
      color: #244f78;
      background: #eef6fc;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.5;
    }

    .tag-print-instruction-icon {
      flex: 0 0 auto;
      font-size: 16px;
      line-height: 1.25;
    }

    .tag-paper-missing {
      color: #8a5a08;
      background: #fff8e8;
    }

    .assembly-tagging-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      padding: 18px;
    }

    .assembly-tagging-card {
      overflow: hidden;
      border: 1px solid #dce5ef;
      border-radius: 13px;
      background: white;
    }

    .assembly-tagging-card-title {
      margin: 0;
      padding: 14px 16px;
      color: white;
      background: #194776;
      font-size: 17px;
      text-align: center;
    }

    .assembly-tagging-image {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 260px;
      padding: 14px;
      border-bottom: 1px solid #e2e8f0;
      background: #f6f8fb;
    }

    .assembly-tagging-image img {
      display: block;
      width: 100%;
      height: 250px;
      object-fit: contain;
      border-radius: 8px;
      background: white;
      cursor: zoom-in;
    }

    .assembly-tagging-information {
      padding: 15px 16px;
    }

    .assembly-tagging-type {
      display: inline-block;
      margin-bottom: 9px;
      padding: 5px 9px;
      border-radius: 999px;
      color: #194776;
      background: #e8f1fb;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .assembly-tagging-description {
      margin: 0;
      color: #627288;
      line-height: 1.55;
    }

    .loading-message,
    .error-message,
    .empty-message {
      padding: 35px;
      border-radius: 14px;
      text-align: center;
      background: white;
    }

    .error-message {
      color: #b42318;
      background: #fff1f1;
      border: 1px solid #ffc7c7;
    }

    .empty-message {
      color: #805b10;
      background: #fff9e9;
      border: 1px solid #eed895;
    }

    .spinner {
      display: inline-block;
      width: 24px;
      height: 24px;
      margin-right: 10px;
      vertical-align: middle;
      border: 4px solid #d6e4f2;
      border-top-color: #194776;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .image-modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 72px 24px 92px;
      background: rgba(9, 24, 42, 0.92);
    }

    .image-modal.open {
      display: flex;
    }

    .modal-viewport {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 12px;
      cursor: grab;
      touch-action: none;
    }

    .modal-viewport.dragging {
      cursor: grabbing;
    }

    .modal-pan-layer {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      transform: translate3d(0, 0, 0);
      will-change: transform;
    }

    .modal-image {
      display: block;
      max-width: 96vw;
      max-height: calc(100vh - 180px);
      object-fit: contain;
      border-radius: 10px;
      background: white;
      box-shadow:
        0 12px 34px
        rgba(0, 0, 0, 0.32);
      transform: scale(1);
      transform-origin: center center;
      transition: transform 0.14s ease;
      user-select: none;
      -webkit-user-drag: none;
      will-change: transform;
    }

    .modal-close {
      position: fixed;
      top: 18px;
      right: 22px;
      z-index: 1003;
      width: 48px;
      height: 48px;
      border: 1px solid rgba(255,255,255,0.50);
      border-radius: 50%;
      color: white;
      background: rgba(255,255,255,0.14);
      font-size: 29px;
      cursor: pointer;
    }

    .modal-close:hover {
      background: rgba(255,255,255,0.24);
    }

    .modal-zoom-controls {
      position: fixed;
      left: 50%;
      bottom: 22px;
      z-index: 1003;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 9px;
      border: 1px solid rgba(255,255,255,0.32);
      border-radius: 999px;
      background: rgba(17, 42, 70, 0.94);
      box-shadow:
        0 10px 28px
        rgba(0, 0, 0, 0.28);
      transform: translateX(-50%);
    }

    .modal-zoom-button {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      height: 42px;
      padding: 0 13px;
      border: 1px solid rgba(255,255,255,0.38);
      border-radius: 999px;
      color: white;
      background: rgba(255,255,255,0.12);
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
    }

    .modal-zoom-button:hover,
    .modal-zoom-button:focus-visible {
      outline: none;
      background: rgba(255,255,255,0.24);
    }

    .modal-zoom-symbol {
      font-size: 25px;
      line-height: 1;
    }

    .modal-zoom-level {
      min-width: 62px;
      color: white;
      font-size: 14px;
      font-weight: 800;
      text-align: center;
    }

    .modal-zoom-help {
      position: fixed;
      top: 22px;
      left: 24px;
      z-index: 1002;
      padding: 9px 13px;
      border-radius: 999px;
      color: white;
      background: rgba(17, 42, 70, 0.82);
      font-size: 13px;
      font-weight: 700;
    }

    @media (max-width: 700px) {
      .image-modal {
        padding:
          66px 10px 84px;
      }

      .modal-image {
        max-width: 98vw;
        max-height:
          calc(100vh - 165px);
      }

      .modal-zoom-controls {
        bottom: 14px;
        gap: 6px;
        padding: 7px;
      }

      .modal-zoom-button {
        min-width: 40px;
        height: 40px;
        padding: 0 10px;
      }

      .modal-zoom-level {
        min-width: 54px;
      }

      .modal-zoom-help {
        top: 18px;
        left: 12px;
        max-width: calc(100vw - 88px);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    @media (max-width: 700px) {
      body {
        padding: 16px 10px 35px;
      }

      .page-heading {
        padding: 22px;
      }

      .page-heading h1 {
        font-size: 27px;
      }

      .overview-area,
      .part-lists-area {
        padding: 14px;
      }

      .overview-image-container {
        min-height: 240px;
        padding: 10px;
      }

      .actual-part-card .overview-image-container {
        min-height: 300px;
        padding: 14px;
      }

      .assembly-title {
        padding: 17px 18px;
        font-size: 20px;
      }

      .assembly-tagging {
        padding: 0 14px 18px;
      }

      .assembly-tagging-grid {
        grid-template-columns: 1fr;
        padding: 14px;
      }

      .assembly-tagging-image {
        min-height: 220px;
      }

      .assembly-tagging-image img {
        height: 210px;
      }

      .tag-print-requirement {
        margin: 14px 14px 0;
      }

      .tag-print-requirement-header {
        align-items: flex-start;
        flex-direction: column;
        padding: 13px 14px;
      }

      .tag-paper-detail-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        padding: 12px 14px;
      }

      .tag-print-intro,
      .tag-print-instruction {
        padding-left: 14px;
        padding-right: 14px;
      }

      .list-heading {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  
    @media (max-width: 430px) {
      .tag-paper-detail-grid {
        grid-template-columns: 1fr;
      }

      .tag-print-requirement-header h4 {
        font-size: 15px;
      }
    }

    /* Floating Go to Top button */
    .global-back-to-top-button {
      position: fixed;
      right: 26px;
      bottom: 26px;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 112px;
      min-height: 48px;
      padding: 0 17px;
      border: 2px solid #ffffff;
      border-radius: 999px;
      color: #ffffff;
      background: #194776;
      box-shadow:
        0 10px 28px
        rgba(25, 71, 118, 0.30);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(14px);
      transition:
        opacity 0.2s ease,
        visibility 0.2s ease,
        transform 0.2s ease,
        background 0.2s ease;
    }

    .global-back-to-top-button.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .global-back-to-top-button:hover,
    .global-back-to-top-button:focus-visible {
      outline: none;
      background: #28679e;
    }

    .global-back-to-top-arrow {
      font-size: 21px;
      line-height: 1;
    }

    @media (max-width: 700px) {
      .global-back-to-top-button {
        right: 14px;
        bottom: 14px;
        min-width: 52px;
        min-height: 52px;
        padding: 0;
      }

      .global-back-to-top-text {
        display: none;
      }
    }


    /* Simplified red-marking legend */
    .diagram-legend {
      margin: 0 18px 18px;
      overflow: hidden;
      border: 1px solid #f0b6b6;
      border-radius: 13px;
      background: #fffafa;
      box-shadow:
        0 6px 16px
        rgba(157, 33, 33, 0.07);
    }

    .diagram-legend-header {
      padding: 13px 16px;
      border-bottom: 1px solid #f3cccc;
      background: #fff1f1;
    }

    .diagram-legend-title {
      margin: 0;
      color: #8f1d1d;
      font-size: 16px;
      font-weight: 800;
    }

    .diagram-selection-summary {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 10px;
      padding: 12px 16px 0;
    }

    .diagram-selection-box {
      padding: 10px 12px;
      border: 1px solid #ead4d4;
      border-radius: 10px;
      background: white;
    }

    .diagram-selection-box span {
      display: block;
      margin-bottom: 3px;
      color: #7a8797;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }

    .diagram-selection-box strong {
      display: block;
      color: #183f6f;
      font-size: 12px;
      line-height: 1.4;
    }

    .diagram-legend-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 10px;
      padding: 12px 16px;
    }

    .diagram-legend-item {
      display: grid;
      grid-template-columns: 54px 1fr;
      gap: 11px;
      align-items: center;
      min-height: 66px;
      padding: 11px;
      border: 1px solid #f2d4d4;
      border-radius: 11px;
      background: white;
    }

    .diagram-legend-symbol {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
    }

    .red-dashed-symbol {
      width: 46px;
      height: 30px;
      border: 3px dashed #e32636;
      border-radius: 4px;
      background: #fffafa;
    }

    .red-label-symbol {
      color: #e32636;
      font-size: 11px;
      font-weight: 900;
      line-height: 1.2;
      text-align: center;
      white-space: pre-line;
    }

    .diagram-legend-copy strong {
      display: block;
      margin-bottom: 3px;
      color: #8f1d1d;
      font-size: 13px;
    }

    .diagram-legend-copy span {
      display: block;
      color: #65758a;
      font-size: 11px;
      line-height: 1.45;
    }

    .diagram-label-guide {
      padding: 0 16px 12px;
    }

    .diagram-label-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .diagram-label-chip {
      padding: 6px 9px;
      border: 1px solid #efc5c5;
      border-radius: 999px;
      color: #8f1d1d;
      background: white;
      font-size: 10px;
      font-weight: 800;
    }

    .diagram-legend-note {
      margin: 0;
      padding: 9px 16px;
      border-top: 1px solid #f3d2d2;
      color: #65758a;
      background: #fffdfd;
      font-size: 10px;
      line-height: 1.45;
    }

