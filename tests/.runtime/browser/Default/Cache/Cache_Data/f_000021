  <script>
    const WEB_APP_URL =
      "\/vehicle-information-system\/index.php";

    const SELECTED_MODEL =
      "X50";

    const SELECTED_VARIANT =
      "FL";

    const SELECTED_GRADE =
      "STANDARD";

    const SELECTED_MODULE =
      "ER";


    document.addEventListener(
      'DOMContentLoaded',
      function () {
        setupModalZoomControls();
        loadResults();
      }
    );


    function loadResults() {
      document.getElementById(
        'selectionPath'
      ).textContent =
        SELECTED_MODEL +
        ' → ' +
        SELECTED_VARIANT +
        ' → ' +
        SELECTED_GRADE +
        ' → ' +
        SELECTED_MODULE;

      if (
        !SELECTED_MODEL ||
        !SELECTED_VARIANT ||
        !SELECTED_GRADE ||
        !SELECTED_MODULE
      ) {
        showError(
          'Selection information is incomplete.'
        );

        return;
      }

      google.script.run
        .withSuccessHandler(displayResults)
        .withFailureHandler(function (error) {
          showError(
            error && error.message
              ? error.message
              : 'Unable to load the information.'
          );
        })
        .getParts(
          SELECTED_MODEL,
          SELECTED_VARIANT,
          SELECTED_GRADE,
          SELECTED_MODULE
        );
    }


    function displayResults(response) {
      const results =
        document.getElementById('results');

      const summary =
        document.getElementById(
          'resultSummary'
        );

      results.innerHTML = '';
      summary.innerHTML = '';

      if (!response || !response.found) {
        const emptyMessage =
          document.createElement('div');

        emptyMessage.className =
          'empty-message';

        emptyMessage.textContent =
          response && response.message
            ? response.message
            : 'No matching information was found.';

        results.appendChild(
          emptyMessage
        );

        return;
      }

      appendSummaryChip(
        summary,
        response.assemblyCount +
        (
          response.assemblyCount === 1
            ? ' assembly'
            : ' assemblies'
        )
      );

      appendSummaryChip(
        summary,
        response.totalPictures +
        (
          response.totalPictures === 1
            ? ' picture'
            : ' pictures'
        )
      );

      if (response.taggingCount > 0) {
        appendSummaryChip(
          summary,
          response.taggingCount +
          (
            response.taggingCount === 1
              ? ' tagging example'
              : ' tagging examples'
          )
        );
      }

      /*
       * Required page order:
       * 1. Normal OVERVIEW_DATABASE information
       * 2. VARIANT_TAGGING information
       * 3. OPL records from OVERVIEW_DATABASE
       */
      const contentGroups =
        separateResultContent(
          response.assemblies || []
        );

      contentGroups.overviewAssemblies
        .forEach(function (assembly) {
          renderAssemblySection(
            results,
            assembly,
            'overview'
          );
        });

      if (
        response.taggingExamples &&
        response.taggingExamples.length > 0
      ) {
        renderStandaloneTagging(
          results,
          response.taggingExamples,
          response.tagPaperRequirement
        );
      }

      contentGroups.oplAssemblies
        .forEach(function (assembly) {
          renderAssemblySection(
            results,
            assembly,
            'opl'
          );
        });
    }


    function separateResultContent(
      assemblies
    ) {
      const overviewAssemblies = [];
      const oplAssemblies = [];

      assemblies.forEach(function (
        assembly
      ) {
        const normalItems = [];
        const oplItems = [];

        (assembly.overview || [])
          .forEach(function (item) {
            if (isOplOverviewItem(item)) {
              oplItems.push(item);
            } else {
              normalItems.push(item);
            }
          });

        if (normalItems.length > 0) {
          overviewAssemblies.push({
            assemblyName:
              assembly.assemblyName,
            sortOrder:
              assembly.sortOrder,
            overview:
              normalItems
          });
        }

        if (oplItems.length > 0) {
          oplAssemblies.push({
            assemblyName:
              assembly.assemblyName,
            sortOrder:
              assembly.sortOrder,
            overview:
              oplItems
          });
        }
      });

      return {
        overviewAssemblies:
          overviewAssemblies,
        oplAssemblies:
          oplAssemblies
      };
    }


    function isOplOverviewItem(item) {
      const pictureName =
