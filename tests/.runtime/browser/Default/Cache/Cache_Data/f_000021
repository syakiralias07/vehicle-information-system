      header.appendChild(title);

      const selectionSummary =
        document.createElement('div');

      selectionSummary.className =
        'diagram-selection-summary';

      selectionSummary.appendChild(
        buildDiagramSelectionBox(
          'Comparison Baseline',
          legendContext.baselineLabel
        )
      );

      selectionSummary.appendChild(
        buildDiagramSelectionBox(
          'Current Selection',
          legendContext.currentSelection
        )
      );

      const grid =
        document.createElement('div');

      grid.className =
        'diagram-legend-grid';

      grid.appendChild(
        buildDiagramLegendItem(
          'red-dashed-symbol',
          '',
          'Red Dashed Box',
          'Part or assembly differs from the ' +
            legendContext.baselineLabel +
            '.'
        )
      );

      grid.appendChild(
        buildDiagramLegendItem(
          'red-label-symbol',
          legendContext.symbolText,
          'Red Label',
          'Shows which variant, grade or market the highlighted difference applies to.'
        )
      );

      const guide =
        document.createElement('div');

      guide.className =
        'diagram-label-guide';

      const chips =
        document.createElement('div');

      chips.className =
        'diagram-label-chips';

      (legendContext.chips || [])
        .forEach(function (labelText) {
          const chip =
            document.createElement('span');

          chip.className =
            'diagram-label-chip';

          chip.textContent =
            labelText;

          chips.appendChild(chip);
        });

      guide.appendChild(chips);

      const note =
        document.createElement('p');

      note.className =
        'diagram-legend-note';

      const noteStrong =
        document.createElement('strong');

      noteStrong.textContent =
        'No red marking: ';

      const noteText =
        document.createTextNode(
          'follows the ' +
          legendContext.baselineLabel +
          '. Red markings identify specification differences only, not defects or rejection.'
        );

      note.appendChild(noteStrong);
      note.appendChild(noteText);

      legend.appendChild(header);
      legend.appendChild(
        selectionSummary
      );
      legend.appendChild(grid);
      legend.appendChild(guide);
