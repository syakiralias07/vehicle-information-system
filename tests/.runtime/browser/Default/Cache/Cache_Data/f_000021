    function getDiagramLegendContext() {
      const model =
        String(SELECTED_MODEL || '').trim();

      const variant =
        String(SELECTED_VARIANT || '').trim();

      const grade =
        String(SELECTED_GRADE || '').trim();

      const modelUpper =
        model.toUpperCase();

      const variantUpper =
        variant.toUpperCase();

      const gradeUpper =
        grade.toUpperCase();

      const currentSelection =
        [model, variant, grade]
          .filter(Boolean)
          .join(' — ');

      let baselineLabel =
        'Standard Specification';

      if (modelUpper === 'X50') {
        baselineLabel =
          'X50 FL Standard';
      } else if (modelUpper === 'S70') {
        baselineLabel =
          'S70 MC Standard';
      }

      let displayLabel =
        variantUpper ||
        modelUpper ||
        'SELECTED SPECIFICATION';

      const isX50LvMarket =
        modelUpper === 'X50' &&
        variantUpper === 'A5 LV' &&
        (
          gradeUpper === 'VIETNAM' ||
          gradeUpper === 'MEXICO'
        );

      const isS70LvGrade =
        modelUpper === 'S70' &&
        variantUpper === 'AI-MY(LV)' &&
        (
          gradeUpper === 'EXECUTIVE' ||
          gradeUpper === 'PREMIUM' ||
          gradeUpper === 'FLAGSHIP'
        );

      if (
        isX50LvMarket ||
        isS70LvGrade
      ) {
        displayLabel =
          'LV ' + gradeUpper;
      }

      const chips = [];

      if (
        isX50LvMarket ||
        isS70LvGrade
      ) {
        chips.push(
          'LV = Applies to all LV specifications'
        );
      }

      chips.push(
        displayLabel +
        ' = Current selection'
      );

      return {
        baselineLabel:
          baselineLabel,

        currentSelection:
          currentSelection ||
          'Current vehicle selection',

        displayLabel:
          displayLabel,

        symbolText:
          formatDiagramLegendLabel_(
            displayLabel
          ),

        chips:
          chips
      };
    }


    function formatDiagramLegendLabel_(
      labelText
    ) {
      const label =
        String(labelText || '').trim();

      if (!label) {
        return '';
      }

      if (
        label.toUpperCase().indexOf('LV ') === 0
      ) {
        return (
          'LV\n' +
          label.substring(3)
        );
      }

      return label;
    }


