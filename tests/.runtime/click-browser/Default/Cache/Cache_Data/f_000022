<body>
  <div class="page-container">

    <header class="header">

      <div
        id="companyLogoContainer"
        class="company-logo-container"
      >
        <img
          id="companyLogo"
          class="company-logo"
          alt="Company logo"
        >
      </div>

      <h1>Vehicle Information System</h1>

      <p>
        Click a vehicle picture to select the model.
      </p>
    </header>

    <main class="selection-card">

      <h2 class="section-heading">
        Select Model
      </h2>

      <p class="section-description">
        Choose a vehicle model to continue to
        the variant comparison page.
      </p>

      <div
        id="modelGrid"
        class="model-grid"
      >
        <div class="loading-message">
          <span class="spinner"></span>
          Loading vehicle models...
        </div>
      </div>

      <div class="flow-information">
        Model Picture → Variant Comparison →
        Full Underbody → Module → Parts
      </div>

    </main>

  </div>

  <script>
    const WEB_APP_URL =
      "\/vehicle-information-system\/index.php";


    document.addEventListener(
      'DOMContentLoaded',
      loadHomePage
    );


    function loadHomePage() {
      loadHomePageSettings();
      loadModelCards();
    }


    function loadHomePageSettings() {
      google.script.run
        .withSuccessHandler(
          applyHomePageSettings
        )
        .withFailureHandler(function (error) {
          console.error(
            'Unable to load logo/background:',
            error
          );
        })
        .getHomePageSettings();
    }


    function applyHomePageSettings(settings) {
      if (!settings) {
        return;
      }

      if (settings.backgroundUrl) {
        const backgroundValue =
          'url(' +
          JSON.stringify(
            settings.backgroundUrl
          ) +
          ')';

        document.documentElement.style
          .setProperty(
            '--page-background-image',
            backgroundValue
          );
      }

      if (settings.logoUrl) {
        const logoContainer =
          document.getElementById(
            'companyLogoContainer'
          );

        const logo =
          document.getElementById(
            'companyLogo'
          );

        logo.src =
          settings.logoUrl;

        logo.alt =
          settings.logoAlt ||
          'Company logo';

        logo.onerror = function () {
          logoContainer.classList.remove(
            'visible'
          );
        };

        logoContainer.classList.add(
          'visible'
        );
      }
    }


    function loadModelCards() {
      google.script.run
        .withSuccessHandler(
          displayModelCards
        )
        .withFailureHandler(function (error) {
          showModelError(
            error && error.message
              ? error.message
              : 'Unable to load vehicle models.'
          );
        })
        .getModelCards();
    }


    function displayModelCards(response) {
      const modelGrid =
        document.getElementById(
          'modelGrid'
        );

      modelGrid.innerHTML = '';

      if (!response || !response.found) {
        const emptyMessage =
          document.createElement('div');

        emptyMessage.className =
          'empty-message';

        emptyMessage.textContent =
          response && response.message
            ? response.message
            : 'No active models were found.';

        modelGrid.appendChild(
          emptyMessage
        );

        return;
      }

      response.models.forEach(function (
        item
      ) {
        const card =
          document.createElement('button');

        card.type = 'button';
        card.className = 'model-card';

        if (
          String(item.model || '')
            .trim()
            .toUpperCase() === 'S70'
        ) {
          card.classList.add(
            'model-card-s70'
          );
        }

        card.setAttribute(
          'aria-label',
          'Select ' + item.displayName
        );

        card.onclick = function () {
          openVariantPage(item.model);
        };

        const imageFrame =
          document.createElement('div');

        imageFrame.className =
          'model-image-frame';

        if (item.imageUrl) {
          const image =
            document.createElement('img');

          image.className =
            'model-image';

          image.src =
            item.imageUrl;

          image.alt =
            item.displayName +
            ' vehicle model';

          image.loading =
            'lazy';

          image.onerror = function () {
            imageFrame.innerHTML =
              '<div class="no-image">' +
                'Picture unavailable' +
              '</div>';
          };

          imageFrame.appendChild(image);
        } else {
          imageFrame.innerHTML =
            '<div class="no-image">' +
              'Add model picture link' +
            '</div>';
        }

        const information =
          document.createElement('div');

        information.className =
          'model-information';

        const name =
          document.createElement('span');

        name.className =
          'model-name';

        name.textContent =
          item.displayName;

        const action =
          document.createElement('span');

        action.className =
          'model-action';

        const actionText =
          document.createElement('span');

        actionText.textContent =
          'Click picture to continue';

        const arrow =
          document.createElement('span');

        arrow.className =
          'arrow';

        arrow.textContent =
          '→';

        action.appendChild(
          actionText
        );

        action.appendChild(
          arrow
        );

        information.appendChild(name);
        information.appendChild(action);

        card.appendChild(imageFrame);
        card.appendChild(information);

        modelGrid.appendChild(card);
      });
    }


    function openVariantPage(model) {
      if (!model) {
        return;
      }

      const variantPageUrl =
        WEB_APP_URL +
        '?page=variants' +
        '&model=' +
        encodeURIComponent(model);

      window.top.location.href =
        window.visPlantUrl(variantPageUrl);
    }


    function showModelError(messageText) {
      const modelGrid =
        document.getElementById(
          'modelGrid'
        );

      modelGrid.innerHTML = '';

      const errorMessage =
        document.createElement('div');

      errorMessage.className =
        'error-message';

      errorMessage.textContent =
        messageText;

      modelGrid.appendChild(
        errorMessage
      );
    }
  </script>


  <button
    id="globalBackToTopButton"
    class="global-back-to-top-button"
    type="button"
    aria-label="Go to top of page"
    title="Go to top"
  >
    <span class="global-back-to-top-arrow">↑</span>
    <span class="global-back-to-top-text">Go to Top</span>
  </button>

  <script>
    (function () {
      const button =
        document.getElementById(
          'globalBackToTopButton'
        );

      if (!button) {
        return;
      }

      function updateBackToTopButton() {
        const pageCanScroll =
          document.documentElement.scrollHeight >
          window.innerHeight + 80;

        const hasScrolledDown =
          window.scrollY > 320;

        button.classList.toggle(
          'show',
          pageCanScroll && hasScrolledDown
        );
      }

      button.addEventListener(
        'click',
        function () {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        }
      );

      window.addEventListener(
        'scroll',
        updateBackToTopButton,
        { passive: true }
      );

      window.addEventListener(
        'resize',
        updateBackToTopButton
      );

      document.addEventListener(
        'DOMContentLoaded',
        updateBackToTopButton
      );

      updateBackToTopButton();
    })();
  </script>

