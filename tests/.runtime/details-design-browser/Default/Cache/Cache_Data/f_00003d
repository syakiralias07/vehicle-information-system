<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8">
  <base target="_top">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 22px 16px 50px;
      font-family: Arial, Helvetica, sans-serif;
      color: #172033;
      background: #f2f6fb;
    }

    .page-container {
      width: 100%;
      max-width: 1220px;
      margin: 0 auto;
    }

    .back-button {
      min-height: 46px;
      margin-bottom: 24px;
      padding: 0 20px;
      border: 1px solid #194776;
      border-radius: 10px;
      color: #194776;
      background: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .back-button:hover {
      color: white;
      background: #194776;
    }

    .page-heading {
      margin-bottom: 24px;
      padding: 28px;
      border-radius: 18px;
      color: white;
      background:
        linear-gradient(
          135deg,
          #153f72,
          #28679e
        );
      box-shadow:
        0 12px 35px
        rgba(24, 66, 108, 0.18);
    }

    .page-heading h1 {
      margin: 0 0 10px;
      font-size: 34px;
    }

    .selection-path {
      margin: 0;
      color: #dcecff;
      font-size: 18px;
    }

    .grade-section {
      padding: 28px;
      border: 1px solid #dce5ef;
      border-radius: 18px;
      background: white;
      box-shadow:
        0 10px 30px
        rgba(31, 68, 112, 0.10);
    }

    .section-title {
      margin: 0 0 8px;
      color: #194776;
      text-align: center;
      font-size: 27px;
    }

    .section-description {
      margin: 0 0 25px;
      color: #68788d;
      text-align: center;
      line-height: 1.6;
    }

    .grade-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .grade-card {
      overflow: hidden;
      padding: 0;
      border: 2px solid #d8e3ef;
      border-radius: 16px;
      color: #183f6f;
      background: #f8fbff;
      text-align: left;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .grade-card:hover {
      border-color: #245d97;
      background: #edf5fd;
      transform: translateY(-4px);
      box-shadow:
        0 12px 24px
        rgba(31, 68, 112, 0.16);
    }

    .grade-picture {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 230px;
      padding: 14px;
      background: #eef3f8;
    }

    .grade-picture img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 9px;
      background: white;
    }

    .grade-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      padding: 20px;
      border: 1px dashed #b7c8da;
      border-radius: 9px;
      color: #718399;
      background: white;
      text-align: center;
      line-height: 1.5;
    }

    .grade-information {
      padding: 21px;
    }

    .grade-name {
      display: block;
      margin-bottom: 9px;
      color: #194776;
      font-size: 22px;
      font-weight: 800;
    }

    .grade-description {
      display: block;
      min-height: 58px;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #dbe5ef;
      color: #52677f;
      font-size: 14px;
      line-height: 1.6;
      white-space: pre-line;
    }

    .comparison-section {
      margin-top: 28px;
      padding: 28px;
      border: 1px solid #dce5ef;
      border-radius: 18px;
      background: white;
      box-shadow:
        0 10px 30px
        rgba(31, 68, 112, 0.10);
    }

    .comparison-wrapper {
      overflow-x: auto;
      margin-top: 22px;
      border: 1px solid #dce5ef;
      border-radius: 14px;
    }

    .comparison-mobile-hint {
      display: none;
    }

    .comparison-table {
      width: 100%;
      min-width: 980px;
      border-collapse: collapse;
      background: white;
    }

    .comparison-table th {
      padding: 16px;
      border-bottom: 1px solid #dce5ef;
      color: white;
      background: #194776;
      text-align: center;
      font-size: 15px;
    }

    .comparison-table th:first-child {
      width: 210px;
      text-align: left;
    }

    .comparison-table td {
      padding: 16px;
      border-top: 1px solid #d7e3ee;
      border-right: 1px solid #d7e3ee;
      vertical-align: top;
      text-align: center;
    }

    /* Strong horizontal divider between different comparison items. */
    .comparison-table tbody tr + tr td {
      border-top: 8px solid #d4e5f2;
    }

    .comparison-table td:last-child,
    .comparison-table th:last-child {
      border-right: none;
    }

    .comparison-part-name {
      color: #194776;
      background: #edf5fb;
      border-right: 4px solid #194776 !important;
      text-align: left !important;
      font-weight: 800;
      line-height: 1.5;
    }

    .comparison-data-cell {
      position: relative;
      background: #ffffff;
    }

    /* Strong vertical divider between separate grade groups. */
    .comparison-group-divider {
      border-left: 5px solid #2b6f9e !important;
    }

    .comparison-cell-merged {
      background: #f1fbf7;
      box-shadow: inset 0 0 0 2px #9fd7c0;
    }

    .comparison-cell-single {
      background: #ffffff;
    }

    .comparison-usage-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      margin-bottom: 12px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.45px;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .comparison-usage-badge.same-part {
      color: #116149;
      background: #dff5eb;
      border: 1px solid #90cfb5;
    }

    .comparison-usage-badge.single-grade {
      color: #194776;
      background: #e6f1fa;
      border: 1px solid #b7d2e6;
    }

    .comparison-image-box {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 170px;
      margin-bottom: 12px;
      padding: 8px;
      border: 1px solid #dce5ef;
      border-radius: 10px;
      background: #f7f9fc;
    }

    .comparison-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 7px;
      background: white;
      cursor: zoom-in;
    }

    .comparison-placeholder {
      color: #8090a3;
      font-size: 13px;
      line-height: 1.5;
    }

    .comparison-item-name {
      display: block;
      min-height: 42px;
      margin-bottom: 9px;
      color: #194776;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.45;
    }

    .comparison-number-label {
      display: block;
      margin-bottom: 4px;
      color: #708096;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .comparison-part-number {
      display: block;
      color: #183f6f;
      font-size: 16px;
      font-weight: 800;
    }

    .loading-message,
    .error-message,
    .empty-message {
      padding: 35px;
      border-radius: 14px;
      text-align: center;
      background: white;
    }

    .error-message {
      color: #b42318;
      background: #fff1f1;
      border: 1px solid #ffc7c7;
    }

    .empty-message {
      color: #805b10;
      background: #fff9e9;
      border: 1px solid #eed895;
    }

    .spinner {
      display: inline-block;
      width: 24px;
      height: 24px;
      margin-right: 10px;
      vertical-align: middle;
      border: 4px solid #d6e4f2;
      border-top-color: #194776;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    @media (max-width: 900px) {
      .grade-grid {
        grid-template-columns: 1fr;
      }

      .grade-card {
        display: grid;
        grid-template-columns: 260px 1fr;
      }

      .grade-picture {
        height: 190px;
      }
    }

    @media (max-width: 620px) {
      body {
        padding: 12px 8px 32px;
      }

      .page-container {
        max-width: 100%;
      }

      .back-button {
        min-height: 42px;
        margin-bottom: 14px;
        padding: 0 14px;
        border-radius: 9px;
        font-size: 13px;
      }

      .page-heading,
      .grade-section {
        padding: 16px;
        border-radius: 14px;
      }

      .page-heading {
        margin-bottom: 16px;
      }

      .page-heading h1 {
        margin-bottom: 6px;
        font-size: 24px;
        line-height: 1.2;
      }

      .selection-path {
        font-size: 13px;
        line-height: 1.5;
      }

      .section-title {
        font-size: 21px;
        line-height: 1.3;
      }

      .section-description {
        margin-bottom: 16px;
        font-size: 13px;
        line-height: 1.5;
      }

      .grade-grid {
        gap: 12px;
      }

      .grade-card {
        display: block;
        border-radius: 13px;
      }

      .grade-picture {
        height: 180px;
        padding: 9px;
      }

      .grade-information {
        padding: 14px;
      }

      .grade-name {
        margin-bottom: 6px;
        font-size: 18px;
      }

      .grade-description {
        min-height: 0;
        margin-top: 7px;
        padding-top: 7px;
        font-size: 12px;
        line-height: 1.45;
      }

      /*
       * Phone-friendly comparison view:
       * convert the wide desktop table into stacked cards.
       */
      .comparison-section {
        margin-top: 16px;
        padding: 14px 10px;
        border-radius: 14px;
      }

      .comparison-section .section-title {
        padding: 0 5px;
        font-size: 20px;
        line-height: 1.3;
      }

      .comparison-section .section-description {
        padding: 0 5px;
        font-size: 12px;
        line-height: 1.45;
      }

      .comparison-mobile-hint {
        display: block;
        margin: 8px 5px 0;
        padding: 9px 11px;
        border-radius: 9px;
        color: #52677f;
        background: #edf5fb;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.4;
        text-align: center;
      }

      .comparison-wrapper {
        overflow: visible;
        margin-top: 10px;
        border: none;
        border-radius: 0;
      }

      .comparison-table,
      .comparison-table tbody,
      .comparison-table tr,
      .comparison-table td {
        display: block;
        width: 100%;
      }

      .comparison-table {
        min-width: 0;
        border-collapse: separate;
        border-spacing: 0;
        background: transparent;
      }

      .comparison-table thead {
        display: none;
      }

      .comparison-table tbody tr {
        overflow: hidden;
        margin-bottom: 16px;
        border: 1px solid #d7e3ee;
        border-radius: 13px;
        background: #ffffff;
        box-shadow:
          0 5px 14px
          rgba(31, 68, 112, 0.08);
      }

      .comparison-table tbody tr:last-child {
        margin-bottom: 0;
      }

      .comparison-table td {
        padding: 12px;
        border-top: 1px solid #e3ebf3;
        border-right: none;
      }

      .comparison-table tbody tr + tr td {
        border-top: 1px solid #e3ebf3;
      }

      .comparison-part-name {
        padding: 13px 14px !important;
        border-top: none !important;
        border-right: none !important;
        border-bottom: 3px solid #194776 !important;
        color: #ffffff;
        background: #194776;
        text-align: left !important;
        font-size: 15px;
        line-height: 1.35;
      }

      .comparison-data-cell {
        padding: 12px !important;
      }

      .comparison-group-divider {
        border-left: none !important;
        border-top: 5px solid #d4e5f2 !important;
      }

      .comparison-cell-merged {
        background: #f1fbf7;
        box-shadow: none;
      }

      .comparison-cell-single {
        background: #ffffff;
      }

      .comparison-usage-badge {
        display: flex;
        width: fit-content;
        max-width: 100%;
        min-height: 26px;
        margin: 0 auto 9px;
        padding: 5px 9px;
        font-size: 9px;
        line-height: 1.3;
        white-space: normal;
        text-align: center;
      }

      .comparison-image-box {
        height: 150px;
        margin-bottom: 9px;
        padding: 6px;
      }

      .comparison-item-name {
        min-height: 0;
        margin-bottom: 7px;
        font-size: 12px;
        line-height: 1.4;
      }

      .comparison-number-label {
        margin-bottom: 3px;
        font-size: 9px;
      }

      .comparison-part-number {
        font-size: 14px;
      }
    }
  
    /* Floating Go to Top button */
    .global-back-to-top-button {
      position: fixed;
      right: 26px;
      bottom: 26px;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 112px;
      min-height: 48px;
      padding: 0 17px;
      border: 2px solid #ffffff;
      border-radius: 999px;
      color: #ffffff;
      background: #194776;
      box-shadow:
        0 10px 28px
        rgba(25, 71, 118, 0.30);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(14px);
      transition:
        opacity 0.2s ease,
        visibility 0.2s ease,
        transform 0.2s ease,
        background 0.2s ease;
    }

    .global-back-to-top-button.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .global-back-to-top-button:hover,
    .global-back-to-top-button:focus-visible {
      outline: none;
      background: #28679e;
    }

    .global-back-to-top-arrow {
      font-size: 21px;
      line-height: 1;
    }

    @media (max-width: 700px) {
      .global-back-to-top-button {
        right: 14px;
        bottom: 14px;
        min-width: 52px;
        min-height: 52px;
        padding: 0;
      }

      .global-back-to-top-text {
        display: none;
      }
    }

  </style>

  <script>window.VIS_PLANT="fif";window.VIS_PLANT_LABEL="FiF";</script>
