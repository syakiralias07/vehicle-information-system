<body class="catalogue-detail detail-grades">

  <div class="page-container">

    <button
      class="back-button"
      type="button"
      onclick="returnVariants()"
    >
      ← Back to Variant Selection
    </button>

    <header class="page-heading"><p class="detail-eyebrow"><span>03</span> Grade / market selection <i aria-hidden="true"></i> FiF</p>
      <h1 id="pageTitle">Select Grade</h1>

      <p
        id="selectionPath"
        class="selection-path"
      ></p>
    </header>

    <main id="content">
      <div class="loading-message">
        <span class="spinner"></span>
        Loading grades...
      </div>
    </main>

  </div>

  <script>
    const WEB_APP_URL =
      "\/vehicle-information-system\/index.php";

    const SELECTED_MODEL =
      "X50";

    const SELECTED_VARIANT =
      "A5 LV";


    document.addEventListener(
      'DOMContentLoaded',
      loadGradePage
    );


    function loadGradePage() {
      document.getElementById(
        'selectionPath'
      ).textContent =
        SELECTED_MODEL +
        ' → ' +
        SELECTED_VARIANT +
        ' → Choose selection';

      if (
        !SELECTED_MODEL ||
        !SELECTED_VARIANT
      ) {
        showError(
          'Model or variant is missing.'
        );

        return;
      }

      google.script.run
        .withSuccessHandler(displayGrades)
        .withFailureHandler(function (error) {
          showError(
            error && error.message
              ? error.message
              : 'Unable to load the grades.'
          );
        })
        .getGradePage(
          SELECTED_MODEL,
          SELECTED_VARIANT
        );
    }


    function displayGrades(response) {
      const content =
        document.getElementById('content');

      content.innerHTML = '';

      if (!response || !response.found) {
        showError(
          response && response.message
            ? response.message
            : 'No grades were found.'
        );

        return;
      }

      if (
        response.grades.length === 1
      ) {
        openModulePage(
          response.grades[0].code
        );

        return;
      }

      const section =
        document.createElement('section');

      section.className =
        'grade-section';

      const selectionLabel =
        response.selectionLabel ||
        'Grade';

      document.getElementById(
        'pageTitle'
      ).textContent =
        'Select ' +
        selectionLabel;

      document.getElementById(
        'selectionPath'
      ).textContent =
        SELECTED_MODEL +
        ' → ' +
        SELECTED_VARIANT +
        ' → Choose ' +
        selectionLabel.toLowerCase();

      section.innerHTML =
        '<h2 class="section-title">' +
          escapeHtml(
            response.selectionHeading ||
            ('Choose ' + selectionLabel)
          ) +
        '</h2>' +
        '<p class="section-description">' +
          escapeHtml(
            response.selectionDescription ||
            'Select an option to continue.'
          ) +
        '</p>';

      const grid =
        document.createElement('div');

      grid.className =
        'grade-grid';

      response.grades.forEach(function (
        grade
      ) {
        grid.appendChild(
          buildGradeCard(grade)
        );
      });

      section.appendChild(grid);
      content.appendChild(section);

      renderGradeComparison(
        response.comparisons,
        response.comparisonColumns,
        response.comparisonTitle,
        response.comparisonDescription,
        content
      );
    }


    function renderGradeComparison(
      comparisons,
      comparisonColumns,
      titleText,
      descriptionText,
      parent
    ) {
      if (
        !comparisons ||
        comparisons.length === 0 ||
        !comparisonColumns ||
        comparisonColumns.length === 0
      ) {
        return;
      }

      const section =
        document.createElement('section');

      section.className =
        'comparison-section';

      section.innerHTML =
        '<h2 class="section-title">' +
          escapeHtml(
            titleText ||
            'What Is Different?'
          ) +
        '</h2>' +
        '<p class="section-description">' +
          escapeHtml(
            descriptionText ||
            'The different parts are displayed side by side.'
          ) +
        '</p>';

      const wrapper =
        document.createElement('div');

      wrapper.className =
        'comparison-wrapper';

      const mobileHint =
        document.createElement('div');

      mobileHint.className =
        'comparison-mobile-hint';

      mobileHint.textContent =
        'Scroll down to compare each part by grade / market.';

      section.appendChild(
        mobileHint
      );

      const table =
        document.createElement('table');

      table.className =
        'comparison-table';

      const thead =
        document.createElement('thead');

      const headerRow =
        document.createElement('tr');

      const partHeader =
        document.createElement('th');

      partHeader.textContent =
        'Comparison Item';

      headerRow.appendChild(
        partHeader
      );

      comparisonColumns.forEach(function (
        comparisonColumn
      ) {
        const header =
          document.createElement('th');

        header.textContent =
          SELECTED_MODEL +
          ' ' +
          SELECTED_VARIANT +
          ' ' +
          (
            comparisonColumn.label ||
            comparisonColumn.code
          );

        headerRow.appendChild(
          header
        );
      });

      thead.appendChild(
        headerRow
      );

      const tbody =
        document.createElement('tbody');

      comparisons.forEach(function (
        comparison
      ) {
        const row =
          document.createElement('tr');

        const partCell =
          document.createElement('td');

        partCell.className =
          'comparison-part-name';

        partCell.textContent =
          comparison.partName ||
          'Different Part';

        row.appendChild(partCell);

        let columnIndex = 0;

        while (
          columnIndex < comparisonColumns.length
        ) {
          const item =
            comparison.items &&
            comparison.items[columnIndex]
              ? comparison.items[columnIndex]
              : {};

          let columnSpan = 1;

          while (
            columnIndex + columnSpan <
              comparisonColumns.length &&
            canMergeComparisonItems(
              item,
              comparison.items &&
              comparison.items[
                columnIndex + columnSpan
              ]
                ? comparison.items[
                    columnIndex + columnSpan
                  ]
                : {}
            )
          ) {
            columnSpan++;
          }

          const combinedColumnLabel =
            comparisonColumns
              .slice(
                columnIndex,
                columnIndex + columnSpan
              )
              .map(function (column) {
                return (
                  column.label ||
                  column.code
                );
              })
              .join(' + ');

          const comparisonCell =
            buildComparisonCell(
              item,
              (
                item.partName ||
                comparison.partName ||
                'Different Part'
              ) +
              ' — ' +
              combinedColumnLabel,
              {
                merged: columnSpan > 1,
                labels: comparisonColumns
                  .slice(
                    columnIndex,
                    columnIndex + columnSpan
                  )
                  .map(function (column) {
                    return (
                      column.label ||
                      column.code
                    );
                  })
              }
            );

          comparisonCell.classList.add(
            'comparison-data-cell'
          );

          comparisonCell.classList.add(
            columnSpan > 1
              ? 'comparison-cell-merged'
              : 'comparison-cell-single'
          );

          if (columnIndex > 0) {
            comparisonCell.classList.add(
              'comparison-group-divider'
            );
          }

          if (columnSpan > 1) {
            comparisonCell.colSpan =
              columnSpan;

            comparisonCell.setAttribute(
              'aria-label',
              combinedColumnLabel +
              ' use the same part'
            );

            comparisonCell.title =
              combinedColumnLabel +
              ' use the same part';
          }

          row.appendChild(
            comparisonCell
          );

          columnIndex += columnSpan;
        }

        tbody.appendChild(row);
      });

      table.appendChild(thead);
      table.appendChild(tbody);
      wrapper.appendChild(table);
      section.appendChild(wrapper);
      parent.appendChild(section);
    }


    function canMergeComparisonItems(
      firstItem,
      secondItem
    ) {
      if (!firstItem || !secondItem) {
        return false;
      }

      const firstPartNumber =
        normaliseComparisonValue(
          firstItem.partNumber
        );

      const secondPartNumber =
        normaliseComparisonValue(
          secondItem.partNumber
        );

      /*
       * Items are already within the same comparison row.
       * Therefore, matching non-empty part numbers mean
       * the neighbouring grades use the same part.
       */
      return (
        firstPartNumber !== '' &&
        firstPartNumber ===
          secondPartNumber
      );
    }


    function normaliseComparisonValue(
      value
    ) {
      return String(value || '')
        .trim()
        .toUpperCase();
    }


    function buildComparisonCell(
      item,
      altText,
      groupInformation
    ) {
      const cell =
        document.createElement('td');

      const labels =
        groupInformation &&
        Array.isArray(
          groupInformation.labels
        )
          ? groupInformation.labels
          : [];

      const usageBadge =
        document.createElement('div');

      usageBadge.className =
        'comparison-usage-badge ' +
        (
          groupInformation &&
          groupInformation.merged
            ? 'same-part'
            : 'single-grade'
        );

      usageBadge.textContent =
        groupInformation &&
        groupInformation.merged
          ? 'Same part used by ' +
            labels.join(' + ')
          : (
              labels.length > 0
                ? labels[0] + ' only'
                : 'Single grade'
            );

      const imageBox =
        document.createElement('div');

      imageBox.className =
        'comparison-image-box';

      if (item && item.imageUrl) {
        const image =
          document.createElement('img');

        image.className =
          'comparison-image';

        image.src =
          item.imageUrl;

        image.alt =
          altText ||
          'Grade comparison picture';

        image.title =
          'Click to open the full picture';

        image.onclick = function () {
          window.open(
            item.originalLink ||
            item.imageUrl,
            '_blank'
          );
        };

        image.onerror = function () {
          imageBox.innerHTML =
            '<div class="comparison-placeholder">' +
              'Picture unavailable.<br>' +
              'Check the Drive link and permission.' +
            '</div>';
        };

        imageBox.appendChild(image);
      } else {
        imageBox.innerHTML =
          '<div class="comparison-placeholder">' +
            'Add picture link in GRADE_COMPARISON.' +
          '</div>';
      }

      const itemName =
        document.createElement('span');

      itemName.className =
        'comparison-item-name';

      itemName.textContent =
        item && item.partName
          ? item.partName
          : '—';

      const label =
        document.createElement('span');

      label.className =
        'comparison-number-label';

      label.textContent =
        'Part Number';

      const number =
        document.createElement('span');

      number.className =
        'comparison-part-number';

      number.textContent =
        item && item.partNumber
          ? item.partNumber
          : '—';

      cell.appendChild(usageBadge);
      cell.appendChild(imageBox);
      cell.appendChild(itemName);
      cell.appendChild(label);
      cell.appendChild(number);

      return cell;
    }


    function buildGradeCard(grade) {
      const card =
        document.createElement('button');

      card.className =
        'grade-card';

      card.type = 'button';

      card.onclick = function () {
        openModulePage(
          grade.code
        );
      };

      const picture =
        document.createElement('div');

      picture.className =
        'grade-picture';

      if (grade.imageUrl) {
        const image =
          document.createElement('img');

        image.src =
          grade.imageUrl;

        image.alt =
          grade.displayName ||
          grade.code;

        image.onerror = function () {
          picture.innerHTML =
            '<div class="grade-placeholder">' +
              'Picture unavailable.<br>' +
              'Check the Drive link and permission.' +
            '</div>';
        };

        picture.appendChild(image);
      } else {
        picture.innerHTML =
          '<div class="grade-placeholder">' +
            'Add the grade picture link in GRADE_SELECTION.' +
          '</div>';
      }

      const information =
        document.createElement('div');

      information.className =
        'grade-information';

      const name =
        document.createElement('span');

      name.className =
        'grade-name';

      name.textContent =
        grade.displayName ||
        grade.code;

      const description =
        document.createElement('span');

      description.className =
        'grade-description';

      description.textContent =
        grade.description ||
        'Select this grade to continue.';

      information.appendChild(name);
      information.appendChild(description);
      card.appendChild(picture);
      card.appendChild(information);

      return card;
    }


    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }


    function openModulePage(gradeCode) {
      const modulePageUrl =
        WEB_APP_URL +
        '?page=modules' +
        '&model=' +
        encodeURIComponent(
          SELECTED_MODEL
        ) +
        '&variant=' +
        encodeURIComponent(
          SELECTED_VARIANT
        ) +
        '&grade=' +
        encodeURIComponent(
          gradeCode
        );

      window.top.location.href =
        window.visPlantUrl(modulePageUrl);
    }


    function showError(messageText) {
      const content =
        document.getElementById('content');

      content.innerHTML = '';

      const message =
        document.createElement('div');

      message.className =
        'error-message';

      message.textContent =
        messageText;

      content.appendChild(message);
    }


    function returnVariants() {
      const variantPageUrl =
        WEB_APP_URL +
        '?page=variants' +
        '&model=' +
        encodeURIComponent(
          SELECTED_MODEL
        );

      window.top.location.href =
        window.visPlantUrl(variantPageUrl);
    }
  </script>


  <button
    id="globalBackToTopButton"
    class="global-back-to-top-button"
    type="button"
    aria-label="Go to top of page"
    title="Go to top"
  >
    <span class="global-back-to-top-arrow">↑</span>
    <span class="global-back-to-top-text">Go to Top</span>
  </button>

  <script>
    (function () {
      const button =
        document.getElementById(
          'globalBackToTopButton'
        );

      if (!button) {
        return;
      }

      function updateBackToTopButton() {
        const pageCanScroll =
          document.documentElement.scrollHeight >
          window.innerHeight + 80;

        const hasScrolledDown =
          window.scrollY > 320;

        button.classList.toggle(
          'show',
          pageCanScroll && hasScrolledDown
        );
      }

      button.addEventListener(
        'click',
        function () {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        }
      );

      window.addEventListener(
        'scroll',
        updateBackToTopButton,
        { passive: true }
      );

      window.addEventListener(
        'resize',
        updateBackToTopButton
      );

      document.addEventListener(
        'DOMContentLoaded',
        updateBackToTopButton
      );

      updateBackToTopButton();
    })();
  </script>

